# Opcional para Docker Compose; exporte também no terminal que executa a API.
DB_PASSWORD=suggestions
# Configure também no terminal/IDE da API. Nunca use senha em texto puro aqui.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Gere com --generate-jwt-secret; preserve a chave entre reinícios.
JWT_SECRET_BASE64=
JWT_TTL_SECONDS=900
