{
  "info": {
    "name": "Caixa de Sugestões — JWT Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Administrador cadastrado no PostgreSQL por --setup-admin. A chave JWT é criada automaticamente no servidor. Preencha adminUsername/adminPassword somente no cliente local; login captura accessToken. Execute em ordem, sem exportar credenciais ou tokens reais."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "suggestionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdAt",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Consultar cursos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/courses",
        "auth": {
          "type": "noauth"
        },
        "description": "Esperado: HTTP 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const set = (k,v) => pm.collectionVariables.set(k,v);",
              "const get = k => pm.variables.get(k);",
              "const expect = pm.expect;",
              "const data = pm.response.json();",
              "set('courseId', data[0].id);",
              "pm.test('Contrato', () => {expect(data.length).to.eql(4);});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar categorias",
      "request": {
        "method": "GET",
