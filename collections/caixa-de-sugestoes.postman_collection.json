              "const get = key => pm.collectionVariables.get(key);",
              "const expect = pm.expect;",
              "const data = pm.response.json();",
              "set('suggestionId', data.id); set('createdAt', data.createdAt);",
              "pm.test('Contrato da resposta', () => {expect(data.author).to.eql('Pessoa Exemplo'); expect(data.course.name).to.be.a('string'); expect(data.category.name).to.be.a('string');});"
