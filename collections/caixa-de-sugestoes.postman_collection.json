    {
      "name": "03 - Login do administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "description": "Esperado: HTTP 200.",
        "body": {
          "mode": "raw",
          "raw": "{{loginBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('loginBody', JSON.stringify({username: pm.variables.get('adminUsername'), password: pm.variables.get('adminPassword')}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const set = (k,v) => pm.collectionVariables.set(k,v);",
              "const get = k => pm.variables.get(k);",
              "const expect = pm.expect;",
              "const data = pm.response.json();",
              "set('accessToken', data.accessToken);",
              "pm.test('Contrato', () => {expect(data.tokenType).to.eql('Bearer'); expect(data.accessToken).to.be.a('string'); expect(data.expiresIn).to.be.a('number');});"
            ]
          }
        }
      ]
    },
