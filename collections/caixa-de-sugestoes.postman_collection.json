      "name": "01 - Consultar cursos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/courses",
        "description": "Resultado esperado: HTTP 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const set = (key, value) => pm.collectionVariables.set(key, value);",
              "const get = key => pm.collectionVariables.get(key);",
              "const expect = pm.expect;",
              "const data = pm.response.json();",
              "set('courseId', data[0].id);",
              "pm.test('Contrato da resposta', () => {expect(data.length).to.eql(4);});"
            ]
          }
        }
      ]
    },
